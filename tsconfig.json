{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "jsx": "preserve",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "paths": {
      "/runtime/*": ["./packages/client/src/*"],
      "/warp/*": ["./packages/warp/src/*"]
    },
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/compiler/types/*.d.ts",
    "packages/compiler/fixtures/**/*.tsx"
  ]
}
