node_modules/
dist/
*.tsbuildinfo
.DS_Store
results/*.json
results/*.md
!results/.gitkeep
# The one run the landing page cites. A site that states a measurement ships the measurement it
# states — every other run here is a local one, and belongs to the laptop that made it.
!results/2026-08-20T16-15-54-981Z.json
build/

# Generated by `weft build`, and staged by `weft dev` before it compiles.
.weft/
# A test that builds gets its own directory, because two processes building one application race.
# The pattern rather than a list: a suffixed build directory left behind by a crashed test is
# otherwise untracked output that oxlint then lints and the release's clean-tree check refuses on.
.weft-*/

# Build output: declarations are emitted, never authored.
*.d.ts

# The root licence, copied beside every published package by `pnpm build`.
packages/*/LICENSE

# The "what has to be true next" list, kept out of the repo.
NEXT.md

# Vercel CLI state, and the build output it writes.
.vercel/

# `weft site` output: the build, laid out for a static host.
.site/
