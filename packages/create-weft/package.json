{
  "name": "create-weft",
  "version": "0.1.2",
  "description": "npm create weft — a weft application, with a page you can open.",
  "keywords": [
    "weft",
    "create",
    "scaffold",
    "starter",
    "template",
    "cli"
  ],
  "license": "MIT",
  "author": "raminjafary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raminjafary/weft.git",
    "directory": "packages/create-weft"
  },
  "homepage": "https://github.com/raminjafary/weft#readme",
  "bugs": {
    "url": "https://github.com/raminjafary/weft/issues"
  },
  "type": "module",
  "bin": {
    "create-weft": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@weftjs/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
