{
  "name": "@weftjs/compiler",
  "version": "0.1.6",
  "description": "TSX to Template IR, with effect inference and escape elision.",
  "keywords": [
    "weft",
    "fullstack",
    "ssr",
    "streaming",
    "no-bundler",
    "typescript",
    "compiler",
    "tsx",
    "oxc",
    "jsx"
  ],
  "license": "MIT",
  "author": "raminjafary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raminjafary/weft.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/raminjafary/weft#readme",
  "bugs": {
    "url": "https://github.com/raminjafary/weft/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "weft-compile": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@weftjs/ir": "workspace:*",
    "oxc-parser": "0.147.0"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@weftjs/core": "workspace:*"
  }
}
