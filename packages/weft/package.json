{
  "name": "@weftjs/core",
  "version": "0.1.1",
  "description": "The framework. A folder is an application: routes from the file tree, a plan generated from it, and one command that serves it.",
  "keywords": [
    "weft",
    "fullstack",
    "ssr",
    "streaming",
    "no-bundler",
    "typescript",
    "framework",
    "file-based-routing",
    "cli"
  ],
  "license": "MIT",
  "author": "raminjafary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raminjafary/weft.git",
    "directory": "packages/weft"
  },
  "homepage": "https://github.com/raminjafary/weft#readme",
  "bugs": {
    "url": "https://github.com/raminjafary/weft/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client/boot.d.ts",
      "default": "./dist/client/boot.js"
    },
    "./styles.css": "./dist/assets/styles.css"
  },
  "bin": {
    "weft": "./bin/weft.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@weftjs/adapters": "workspace:*",
    "@weftjs/client": "workspace:*",
    "@weftjs/compiler": "workspace:*",
    "@weftjs/ir": "workspace:*",
    "@weftjs/kernel": "workspace:*",
    "@weftjs/plan": "workspace:*",
    "@weftjs/warp": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
