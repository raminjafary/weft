{
  "name": "weft-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "compile": "node packages/compiler/src/cli.ts",
    "bench": "node packages/bench/src/cli.ts run",
    "bench:list": "node packages/bench/src/cli.ts list",
    "bench:verify": "node packages/bench/src/cli.ts verify",
    "test": "node --test packages/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
