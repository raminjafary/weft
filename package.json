{
  "name": "weft-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "compile": "node packages/compiler/src/cli.ts",
    "bench": "node packages/bench/src/cli.ts run",
    "bench:list": "node packages/bench/src/cli.ts list",
    "bench:verify": "node packages/bench/src/cli.ts verify",
    "test": "node --test packages/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "commitlint": "commitlint --from origin/main --to HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "conventional-changelog-cli": "^5.0.0",
    "playwright": "^1.62.1",
    "rolldown": "^1.2.5",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
