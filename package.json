{
  "name": "weft-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "compile": "node packages/compiler/src/cli.ts",
    "bench": "node packages/bench/src/cli.ts run",
    "bench:list": "node packages/bench/src/cli.ts list",
    "bench:verify": "node packages/bench/src/cli.ts verify",
    "demo": "weft dev demo --devtools",
    "test": "node --test packages/*/test/*.test.ts demo/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "changelog": "commit-and-tag-version --skip.bump --skip.commit --skip.tag",
    "commitlint": "commitlint --from origin/main --to HEAD",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "release": "commit-and-tag-version",
    "demo:build": "weft build demo",
    "demo:start": "weft start demo",
    "build": "node scripts/build-packages.mjs",
    "inspect": "weft dev packages/inspector --devtools",
    "inspect:build": "weft build packages/inspector"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "commit-and-tag-version": "13.1.2",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxlint": "1.79.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "rolldown": "1.2.5",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
